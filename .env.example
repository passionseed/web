# PassionSeed — environment variables
#
# Copy to .env.local and fill in what you need. You do NOT need everything
# below — most features degrade gracefully when their keys are absent.
# Only the "Core" section is required to boot the app.

# -----------------------------------------------------------------------------
# Core (required)
# -----------------------------------------------------------------------------
# Local values are printed by `npx supabase start` (anon + service_role keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL used in emails, OAuth redirects, and absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# AI providers (needed only for the features that call them)
# -----------------------------------------------------------------------------
# Direction Finder + most student-facing AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3
GROQ_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_HOST=

# Self-hosted AI gateway (PathLab ai-chat runs through this when set)
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=

# Text-embeddings inference endpoint (direction finder jobs)
TEI_URL=

# Model override for the PathLab map generator (optional)
PATHLAB_GENERATOR_MODEL=

# -----------------------------------------------------------------------------
# Email (Resend) — transactional mail, invitations, parent updates
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Hackathon subsystem (separate Supabase project + its own integrations)
# -----------------------------------------------------------------------------
HACKATHON_SUPABASE_URL=
HACKATHON_SUPABASE_SERVICE_ROLE_KEY=

# LINE notifications to mentors
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# @passionseed LINE Official Account inbox (/admin/line); a separate channel from the mentor bot above
LINE_OA_CHANNEL_SECRET=
LINE_OA_CHANNEL_ACCESS_TOKEN=

# Web push (VAPID) — generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# ProjectSeed Discord bot (bot/) — voice attendance + reminders
# -----------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
PSEED_COHORT_SLUG=alumni-mvp
PSEED_VOICE_CHANNEL_IDS=
PSEED_REMINDER_INTERVAL_MS=

# SHIFT: Discord channel webhook pinged on each new /shift/apply submission.
# Empty disables the ping.
DISCORD_SHIFT_WEBHOOK_URL=

# SHIFT paid-student Discord join. The bot must belong to the same Discord
# application as Supabase Auth's Discord provider for guilds.join to work.
# Use a dedicated token here when DISCORD_BOT_TOKEN belongs to another app.
# Empty falls back to DISCORD_BOT_TOKEN.
DISCORD_SHIFT_BOT_TOKEN=
DISCORD_SHIFT_GUILD_ID=
# Fallback invite when automatic joining is unavailable.
DISCORD_SHIFT_INVITE_URL=
# Optional extra roles, comma-separated. The cohort role is created by name.
DISCORD_SHIFT_ROLE_IDS=

# SHIFT High island on the web (/shift/island). A direct Postgres URL for the
# quest functions, logged in as the least-privilege role shift_quest_web ONLY:
# never shift_quest_bot, postgres, or the service role (the app refuses any
# other login). The role password is set out of band, never committed.
#   Local sandbox (bot/quests-sandbox.sh): postgresql://shift_quest_web:<password>@127.0.0.1:<port>/postgres
#   Production: the Supavisor pooler, user shift_quest_web.<project ref>, port 6543 (TLS verified against Supabase's CA)
# Empty: /shift/island shows "closed for maintenance". The island also reads
# member roles in the SHIFT server with DISCORD_SHIFT_BOT_TOKEN (or
# DISCORD_BOT_TOKEN) and DISCORD_SHIFT_GUILD_ID above.
SHIFT_QUEST_DATABASE_URL=
# SHIFT_ISLAND_URL is a bot variable (bot/.env), not the web app's: the link the
# quest bot's island card opens. Defaults to NEXT_PUBLIC_SITE_URL + /shift/island.
# https only; http://localhost needs SHIFT_ISLAND_URL_ALLOW_HTTP=1 in bot/.env (local tries only).

# -----------------------------------------------------------------------------
# Meta (Instagram/Facebook DM backfill + outbound)
# -----------------------------------------------------------------------------
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Music embeds (optional learning-node content)
# -----------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
NEXT_PUBLIC_SOUNDCLOUD_CLIENT_ID=
APPLE_MUSIC_TOKEN=

# -----------------------------------------------------------------------------
# Platform / ops
# -----------------------------------------------------------------------------
# Protects /api/cron/* — must match the Authorization: Bearer <secret> header
CRON_SECRET=
# Lets the ops watcher (ops/integration-watch) call /api/ops/integration-health
# and /api/cron/meta-backfill without holding CRON_SECRET
OPS_CRON_SECRET=

# Fine-grained GitHub token, Contents read/write on passionseed/company-brain
# only. Used by /api/cron/brain-sync; the cron skips when it is unset.
BRAIN_GITHUB_TOKEN=

# Signs parent-update unsubscribe links
PARENT_UPDATE_TOKEN_SECRET=

# Salt for the DB-backed rate limiter
RATE_LIMIT_SALT=

# Direct Postgres connection string (scripts only, not the app)
SUPABASE_DB_URL=

# Enables /api/test-* debug routes — leave unset in production
DEBUG_ROUTES_ENABLED=

# Logging
VERBOSE_LOGGING=
APP_VERSION=

# -----------------------------------------------------------------------------
# Feature flags (all optional; defaults are sensible)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_AUTO_SAVE=
NEXT_PUBLIC_AUTO_SAVE_DEBOUNCE_MS=
NEXT_PUBLIC_ENABLE_NEW_PAGE_BUILDER=
NEXT_PUBLIC_ENABLE_TEMPLATES=
NEXT_PUBLIC_MAX_ACTIVITIES_PER_PAGE=
NEXT_PUBLIC_MICRO_PATHLAB_MAP_ID=
NEXT_PUBLIC_PLAN_CONSULT_URL=
NEXT_PUBLIC_CF_BEACON_TOKEN=
RADAR_PREVIEW_UNPUBLISHED=

# -----------------------------------------------------------------------------
# Test-only knobs (never set in production)
# -----------------------------------------------------------------------------
RUN_LIVE_AI_MODEL_TESTS=
DIRECTION_FINDER_TEST_USE_DB=
DIRECTION_FINDER_MODEL_TEST_TIMEOUT_MS=
