{
  "fluid": true,
  "headers": [
    {
      "source": "/data/hackathon/problems/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "functions": {
    "app/api/cron/parent-pathlab-updates/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/meta-backfill/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/brain-sync/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/radar-reel-insights/route.ts": {
      "maxDuration": 60
    },
    "app/api/meta/webhook/route.ts": {
      "maxDuration": 30
    },
    "app/api/cron/shift-island-digest/route.ts": {
      "maxDuration": 60
    },
    "app/api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/parent-pathlab-updates",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/seedstack-retention",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/brain-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/shift-canvas-snapshots",
      "schedule": "45 16 * * *"
    },
    {
      "path": "/api/cron/radar-reel-insights",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/shift-island-digest",
      "schedule": "0 13 * * *"
    }
  ]
}
